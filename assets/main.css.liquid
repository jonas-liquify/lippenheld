  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.icon-embed-medium {
  width: 2.75rem;
  height: 2.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.icon-embed-large {
  width: 3.5rem;
