/* =============================================================
   LIPPENHELD — Liquiflow Theme
   -------------------------------------------------------------
   Naturkosmetik, Lippenbalsam aus Oliven-Antioxidantien.
   Serif-Display (Cormorant Infant) + Serif-Body (Playfair) +
   weit gesperrte Grotesk-Versalien (Outfit) für UI-Elemente.
   Farbwelt: Tinte, Papier, Olive, Ocean, Sand.

   Struktur (Finsweet Client-First):
   1.  Design-Tokens
   2.  Reset & Base
   3.  Typografie
   4.  Layout-Struktur & Section-Baukasten
   5.  Utilities
   6.  Buttons
   7.  Formulare
   8.  Icons & Sterne
   9.  Navigation (Header, Dropdowns, Suche)
   10. Predictive Search
   11. Mini-Cart
   12. Footer, USP-Ticker & Sprach-Picker
   13. Hero & Seitenköpfe
   14. Produkt-Karte
   15. Produkt-Listen & Featured Sections
   16. Bildraster & Kollektionen
   17. Blog
   18. Pagination
   19. Filter (Collection/Search)
   20. Produktseite
   21. Cart-Seite
   22. Content-Sections
   23. Slider-Helfer

   Breakpoints (desktop-first, NUR max-width, in px):
   (max-width: 991px) Tablet · (max-width: 767px) Mobile Landscape · (max-width: 479px) Mobile
   ============================================================= */

/* =============================================================
   1. Design-Tokens
   ============================================================= */
:root {
  /* Marke */
  --color--black: #26261f;
  --color--black-soft: #34342c;
  --color--white: #ffffff;
  --color--paper: #f7f7f7;
  --color--card: #efefee;
  --color--olive: #afbaab;
  --color--ocean: #abbaba;
  --color--sand: #e7ded2;
  --color--dark-green: #232e20;
  --color--red: #450202;

  /* Graustufen */
  --color--neutral-darker: #3d3d35;
  --color--neutral-dark: #5c5c54;
  --color--neutral: #7a7a72;
  --color--neutral-light: #a6a69f;
  --color--neutral-lighter: #d3d3cd;
  --color--neutral-lightest: #e9e9e4;

  /* System */
  --color--success: #eef5ec;
  --color--success-dark: #3f6b34;
  --color--error: #f6ecec;
  --color--error-dark: #8a2b2b;
  --color--focus: #26261f;

  /* Semantik */
  --text-color--primary: var(--color--black);
  --text-color--secondary: var(--color--neutral);
  --text-color--alternate: var(--color--white);
  --background-color--primary: var(--color--white);
  --background-color--secondary: var(--color--paper);
  --background-color--card: var(--color--card);
  --background-color--dark: var(--color--black);
  --border-color--primary: #e2e2dd;
  --border-color--strong: #c9c9c2;
  --border-color--dark: var(--color--black);

  /* Schriftfamilien */
  --font--display: "Cormorant Infant", "Cormorant Garamond", Georgia, "Times New Roman", serif;
  --font--serif: "Playfair", "Playfair Display", Georgia, "Times New Roman", serif;
  --font--sans: "Outfit", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  --font--caption: "PT Serif Caption", "PT Serif", Georgia, serif;

  /* Schriftgrößen (Figma-Tokens) */
  --font-size--h1: 1.75rem;
  --font-size--h2: 1.625rem;
  --font-size--h3: 1.375rem;
  --font-size--h4: 1.125rem;
  --font-size--h5: 1rem;
  --font-size--h6: 0.875rem;
  --font-size--large: 1.25rem;
  --font-size--medium: 1rem;
  --font-size--regular: 0.875rem;
  --font-size--small: 0.8125rem;
  --font-size--tiny: 0.75rem;
  --font-size--micro: 0.5625rem;
  --font-size--nano: 0.5rem;

  /* Letterspacing (Figma-Prozentwerte in em) */
  --tracking--display: 0.1em;
  --tracking--heading: 0.06em;
  --tracking--body: 0.03em;
  --tracking--link: 0.11em;
  --tracking--product: 0.12em;
  --tracking--bullet: 0.19em;
  --tracking--subline: 0.16em;

  /* Abstände (Figma-Variablen) */
  --space--xxx-small: 0.25rem;
  --space--xx-small: 0.75rem;
  --space--x-small: 1rem;
  --space--small: 1.5rem;
  --space--medium: 2.5rem;
  --space--large: 3.75rem;

  /* Seitenrand & Container */
  --side: 3.75rem;
  --container--large: 82.5rem;
  --container--medium: 62.5rem;
  --container--small: 45rem;

  /* Section-Abstände */
  --section-padding: 5rem;
  --section-padding--small: 3.75rem;
  --section-padding--large: 7.5rem;

  /* Navigation */
  --nav--height: 4.75rem;

  /* Radius — die Marke arbeitet mit harten Kanten */
  --radius--small: 0;
  --radius--medium: 0;
  --radius--large: 0;
  --radius--pill: 62.5rem;

  /* Schatten */
  --shadow--xs: 0 1px 2px rgba(38, 38, 31, 0.05);
  --shadow--sm: 0 1px 3px rgba(38, 38, 31, 0.07), 0 4px 14px rgba(38, 38, 31, 0.05);
  --shadow--md: 0 2px 8px rgba(38, 38, 31, 0.08), 0 16px 40px rgba(38, 38, 31, 0.1);

  /* Motion */
  --transition--fast: 160ms ease;
  --transition--base: 320ms cubic-bezier(0.22, 0.61, 0.36, 1);
  --transition--slow: 600ms cubic-bezier(0.22, 0.61, 0.36, 1);

  /* Section-Schema (Default = white, siehe Abschnitt 4) */
  --section-bg: var(--color--white);
  --section-fg: var(--color--black);
  --section-muted: var(--color--neutral);
  --section-border: var(--border-color--primary);
  --section-hairline: var(--border-color--primary);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: var(--color--card);
}

/* Liquiflow-Marker im Browser/Builder unsichtbar */
.li-custom,
.li-tag,
.global-styles,
[li-cloak="hide"],
[x-cloak] {
  display: none !important;
}

/* =============================================================
   2. Reset & Base
   ============================================================= */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background-color: var(--background-color--primary);
  color: var(--text-color--primary);
  font-family: var(--font--serif);
  font-size: var(--font-size--regular);
  line-height: 1.5;
  letter-spacing: var(--tracking--body);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

img,
video,
svg,
iframe {
  max-width: 100%;
  display: block;
}

img,
video {
  height: auto;
  border: 0;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
  color: inherit;
  background: none;
  border: 0;
  padding: 0;
  cursor: pointer;
}

ul,
ol {
  margin: 0;
  padding: 0;
  list-style: none;
}

figure,
blockquote,
p,
h1,
h2,
h3,
h4,
h5,
h6 {
  margin: 0;
}

table {
  border-collapse: collapse;
  width: 100%;
}

hr {
  border: 0;
  border-top: 1px solid var(--section-hairline);
  margin: 0;
}

:focus-visible {
  outline: 2px solid var(--color--focus);
  outline-offset: 2px;
}

::selection {
  background-color: var(--color--black);
  color: var(--color--white);
}

.page-wrapper {
  position: relative;
  overflow-x: clip;
}

.main-wrapper {
  display: block;
}

/* =============================================================
   3. Typografie
   ============================================================= */
h1,
.heading-style-h1 {
  font-family: var(--font--display);
  font-size: var(--font-size--h1);
  font-weight: 600;
  line-height: 1.11;
  letter-spacing: var(--tracking--display);
  text-transform: uppercase;
}

h2,
.heading-style-h2 {
  font-family: var(--font--display);
  font-size: var(--font-size--h2);
  font-weight: 600;
  line-height: 1.11;
  letter-spacing: var(--tracking--heading);
  text-transform: uppercase;
}

h3,
.heading-style-h3 {
  font-family: var(--font--serif);
  font-size: var(--font-size--h3);
  font-weight: 400;
  line-height: 1.5;
  letter-spacing: var(--tracking--body);
}

h4,
.heading-style-h4 {
  font-family: var(--font--serif);
  font-size: var(--font-size--h4);
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: var(--tracking--body);
}

h5,
.heading-style-h5 {
  font-family: var(--font--sans);
  font-size: var(--font-size--h5);
  font-weight: 400;
  line-height: 1.4;
  letter-spacing: var(--tracking--product);
  text-transform: uppercase;
}

h6,
.heading-style-h6 {
  font-family: var(--font--sans);
  font-size: var(--font-size--h6);
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: var(--tracking--link);
  text-transform: uppercase;
}

.text-size-large {
  font-family: var(--font--caption);
  font-size: var(--font-size--large);
  line-height: 1.51;
  letter-spacing: 0.02em;
}

.text-size-medium {
  font-family: var(--font--serif);
  font-size: var(--font-size--medium);
  line-height: 1.47;
  letter-spacing: var(--tracking--body);
}

.text-size-regular {
  font-family: var(--font--serif);
  font-size: var(--font-size--regular);
  line-height: 1.5;
  letter-spacing: var(--tracking--body);
}

.text-size-small {
  font-family: var(--font--serif);
  font-size: var(--font-size--small);
  line-height: 1.5;
  letter-spacing: var(--tracking--body);
}

.text-size-tiny {
  font-family: var(--font--sans);
  font-size: var(--font-size--tiny);
  line-height: 1.56;
  letter-spacing: var(--tracking--link);
}

/* Grotesk-Versalien — die UI-Stimme der Marke */
.text-style-link {
  font-family: var(--font--sans);
  font-size: var(--font-size--tiny);
  font-weight: 500;
  line-height: 1.56;
  letter-spacing: var(--tracking--link);
  text-transform: uppercase;
}

.text-style-product {
  font-family: var(--font--sans);
  font-size: var(--font-size--regular);
  font-weight: 400;
  line-height: 1.26;
  letter-spacing: var(--tracking--product);
  text-transform: uppercase;
}

.text-style-bullet {
  font-family: var(--font--sans);
  font-size: var(--font-size--tiny);
  font-weight: 400;
  line-height: 1.56;
  letter-spacing: var(--tracking--bullet);
}

.text-style-subline {
  font-family: var(--font--sans);
  font-size: var(--font-size--micro);
  font-weight: 500;
  line-height: 1.26;
  letter-spacing: var(--tracking--subline);
  text-transform: uppercase;
}

.text-style-disclaimer {
  font-family: var(--font--sans);
  font-size: var(--font-size--nano);
  font-weight: 500;
  line-height: 1.5;
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--section-muted);
}

.text-weight-bold {
  font-weight: 700;
}

.text-weight-semibold {
  font-weight: 600;
}

.text-weight-medium {
  font-weight: 500;
}

.text-weight-normal {
  font-weight: 400;
}

.text-style-muted {
  color: var(--section-muted);
}

.text-style-strikethrough {
  text-decoration: line-through;
}

.text-style-underline {
  text-decoration: underline;
  text-underline-offset: 0.25rem;
  text-decoration-thickness: 1px;
}

.text-style-italic {
  font-style: italic;
}

.text-style-uppercase {
  text-transform: uppercase;
}

.text-style-nowrap {
  white-space: nowrap;
}

.text-style-2lines {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-style-3lines {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-align-left {
  text-align: left;
}

.text-align-center {
  text-align: center;
}

.text-align-right {
  text-align: right;
}

.text-color-white {
  color: var(--color--white);
}

.text-color-black {
  color: var(--color--black);
}

.text-color-grey {
  color: var(--section-muted);
}

.text-color-red {
  color: var(--color--error-dark);
}

.text-color-green {
  color: var(--color--success-dark);
}

/* Richtext — Shopify-Editorinhalte */
.text-rich-text {
  font-family: var(--font--serif);
  font-size: var(--font-size--regular);
  line-height: 1.5;
  letter-spacing: var(--tracking--body);
}

.text-rich-text h2 {
  font-size: var(--font-size--h2);
  margin-top: 2.5rem;
  margin-bottom: 1rem;
}

.text-rich-text h3 {
  font-size: var(--font-size--h3);
  margin-top: 2rem;
  margin-bottom: 0.75rem;
}

.text-rich-text h4 {
  font-size: var(--font-size--h4);
  margin-top: 1.5rem;
  margin-bottom: 0.5rem;
}

.text-rich-text p {
  margin-top: 0;
  margin-bottom: 1rem;
}

.text-rich-text ul,
.text-rich-text ol {
  margin: 0 0 1rem 1.125rem;
  padding: 0;
  list-style: disc;
}

.text-rich-text ol {
  list-style: decimal;
}

.text-rich-text li {
  margin-bottom: 0.375rem;
}

.text-rich-text a {
  text-decoration: underline;
  text-underline-offset: 0.1875rem;
}

.text-rich-text blockquote {
  font-family: var(--font--display);
  font-size: var(--font-size--h3);
  line-height: 1.4;
  border-left: 1px solid var(--section-hairline);
  padding-left: 1.5rem;
  margin: 2rem 0;
}

.text-rich-text img {
  width: 100%;
  margin: 2rem 0;
}

.text-rich-text > :first-child {
  margin-top: 0;
}

.text-rich-text > :last-child {
  margin-bottom: 0;
}

/* Bogen-Subline (SVG textPath) */
.arc-label_wrapper {
  display: block;
  width: 100%;
}

.arc-label {
  display: block;
  width: 8.75rem;
  height: 2.25rem;
  margin: 0 auto;
  overflow: visible;
  color: inherit;
}

.arc-label.is-left {
  margin-left: 0;
}

.arc-label_text {
  font-family: var(--font--sans);
  font-size: 0.5625rem;
  font-weight: 500;
  letter-spacing: 0.09rem;
  text-transform: uppercase;
  fill: currentColor;
}

@media (max-width: 767px) {
  :root {
    /* Figma-Mobile-Frame: Playfair 13px, Outfit 11px */
    --font-size--regular: 0.8125rem;
    --font-size--small: 0.75rem;
    --font-size--tiny: 0.6875rem;
  }

  h1,
  .heading-style-h1 {
    font-size: 1.375rem;
  }

  h2,
  .heading-style-h2 {
    font-size: 1.25rem;
  }

  h3,
  .heading-style-h3 {
    font-size: 1.125rem;
  }

  .text-size-large {
    font-size: 1rem;
  }

  .text-size-medium {
    font-size: 0.875rem;
  }
}

/* =============================================================
   4. Layout-Struktur & Section-Baukasten
   ============================================================= */
.padding-global {
  padding-left: var(--side);
  padding-right: var(--side);
}

.padding-section {
  padding-top: var(--section-padding);
  padding-bottom: var(--section-padding);
}

.padding-section-small {
  padding-top: var(--section-padding--small);
  padding-bottom: var(--section-padding--small);
}

.padding-section-medium {
  padding-top: var(--section-padding);
  padding-bottom: var(--section-padding);
}

.padding-section-large {
  padding-top: var(--section-padding--large);
  padding-bottom: var(--section-padding--large);
}

.container {
  width: 100%;
  max-width: var(--container-width, var(--container--large));
  margin-left: auto;
  margin-right: auto;
}

.container-large {
  width: 100%;
  max-width: var(--container--large);
  margin-left: auto;
  margin-right: auto;
}

.container-medium {
  width: 100%;
  max-width: var(--container--medium);
  margin-left: auto;
  margin-right: auto;
}

.container-small {
  width: 100%;
  max-width: var(--container--small);
  margin-left: auto;
  margin-right: auto;
}

/* --- Section-Farbschemata ---
   Werden per li-attribute:class auf den .padding-global-Wrapper gesetzt
   und definieren die Section-Variablen um, aus denen sich Text,
   Rahmen, Buttons und Flächen speisen. */
.is-theme-white {
  --section-bg: var(--color--white);
  --section-fg: var(--color--black);
  --section-muted: var(--color--neutral);
  --section-border: var(--border-color--primary);
  --section-hairline: var(--border-color--primary);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: var(--color--card);
}

.is-theme-paper {
  --section-bg: var(--color--paper);
  --section-fg: var(--color--black);
  --section-muted: var(--color--neutral);
  --section-border: var(--border-color--primary);
  --section-hairline: var(--border-color--strong);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: var(--color--white);
}

.is-theme-olive {
  --section-bg: var(--color--olive);
  --section-fg: var(--color--black);
  --section-muted: rgba(38, 38, 31, 0.68);
  --section-border: rgba(38, 38, 31, 0.24);
  --section-hairline: rgba(38, 38, 31, 0.24);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: rgba(255, 255, 255, 0.42);
}

.is-theme-ocean {
  --section-bg: var(--color--ocean);
  --section-fg: var(--color--black);
  --section-muted: rgba(38, 38, 31, 0.68);
  --section-border: rgba(38, 38, 31, 0.24);
  --section-hairline: rgba(38, 38, 31, 0.24);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: rgba(255, 255, 255, 0.42);
}

.is-theme-sand {
  --section-bg: var(--color--sand);
  --section-fg: var(--color--black);
  --section-muted: rgba(38, 38, 31, 0.68);
  --section-border: rgba(38, 38, 31, 0.22);
  --section-hairline: rgba(38, 38, 31, 0.22);
  --section-btn-bg: var(--color--black);
  --section-btn-fg: var(--color--white);
  --section-btn-border: var(--color--black);
  --section-surface: rgba(255, 255, 255, 0.5);
}

.is-theme-black {
  --section-bg: var(--color--black);
  --section-fg: var(--color--white);
  --section-muted: rgba(255, 255, 255, 0.68);
  --section-border: rgba(255, 255, 255, 0.24);
  --section-hairline: rgba(255, 255, 255, 0.2);
  --section-btn-bg: var(--color--white);
  --section-btn-fg: var(--color--black);
  --section-btn-border: var(--color--white);
  --section-surface: rgba(255, 255, 255, 0.08);
}

.is-theme-dark-green {
  --section-bg: var(--color--dark-green);
  --section-fg: var(--color--white);
  --section-muted: rgba(255, 255, 255, 0.68);
  --section-border: rgba(255, 255, 255, 0.24);
  --section-hairline: rgba(255, 255, 255, 0.2);
  --section-btn-bg: var(--color--white);
  --section-btn-fg: var(--color--black);
  --section-btn-border: var(--color--white);
  --section-surface: rgba(255, 255, 255, 0.08);
}

.is-theme-white,
.is-theme-paper,
.is-theme-olive,
.is-theme-ocean,
.is-theme-sand,
.is-theme-black,
.is-theme-dark-green {
  background-color: var(--section-bg);
  color: var(--section-fg);
}

/* Sections, die auf einem eigenen Bild liegen */
.is-theme-transparent {
  background-color: transparent;
}

/* --- Content-Breite --- */
.is-width-small {
  --container-width: var(--container--small);
}

.is-width-medium {
  --container-width: var(--container--medium);
}

.is-width-large {
  --container-width: var(--container--large);
}

.is-width-full {
  --container-width: none;
}

.padding-global.is-width-full {
  padding-left: 0;
  padding-right: 0;
}

/* --- Ausrichtung --- */
.is-align-left {
  text-align: left;
  --content-justify: flex-start;
  --content-align-self: flex-start;
}

.is-align-center {
  text-align: center;
  --content-justify: center;
  --content-align-self: center;
}

.is-align-right {
  text-align: right;
  --content-justify: flex-end;
  --content-align-self: flex-end;
}

.is-align-center .align-auto,
.is-align-center .max-width-xlarge,
.is-align-center .max-width-large,
.is-align-center .max-width-medium,
.is-align-center .max-width-small {
  margin-left: auto;
  margin-right: auto;
}

.is-align-right .align-auto {
  margin-left: auto;
}

/* --- Mobile Section-Abstände ---
   Klassenbasiert, damit sie den Inline-Style der Desktop-Settings
   zuverlässig schlagen (!important > Inline). */
@media (max-width: 767px) {
  .is-mpad-none {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .is-mpad-small {
    padding-top: 2rem !important;
    padding-bottom: 2rem !important;
  }

  .is-mpad-medium {
    padding-top: 3rem !important;
    padding-bottom: 3rem !important;
  }

  .is-mpad-large {
    padding-top: 4.5rem !important;
