          if (!richtext || !toc) return;
          var headings = richtext.querySelectorAll('h2');
          toc.innerHTML = '';
          if (!headings.length) return;
          var usedIds = {};
          headings.forEach(function (heading, index) {
            var base = slugifyHeading(heading.textContent) || ('abschnitt-' + (index + 1));
            var id = base;
            var n = 2;
            while (usedIds[id] || document.getElementById(id)) {
              id = base + '-' + n;
              n += 1;
            }
            usedIds[id] = true;
            heading.id = id;
            var li = document.createElement('li');
            var a = document.createElement('a');
            a.className = 'lh_article-toc_link';
            a.href = '#' + id;
            a.textContent = heading.textContent.trim();
            li.appendChild(a);
            toc.appendChild(li);
          });
