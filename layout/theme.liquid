      (function () {
        function initLhNavScroll() {
          var bar = document.querySelector('.lh_home .section_navbar');
          if (!bar) return;
          var html = document.documentElement;
          function parseRgb(color) {
            var m = color && color.match(/^rgba?\(([^)]+)\)$/i);
            if (!m) return null;
            var parts = m[1].split(',').map(function (p) {
              return parseFloat(p.trim());
            });
            if (parts.length < 3 || parts.some(function (n) { return Number.isNaN(n); })) return null;
            return { r: parts[0], g: parts[1], b: parts[2], a: parts.length > 3 ? parts[3] : 1 };
          }
          function luminance(rgb) {
            if (!rgb) return 0;
            return (0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b) / 255;
          }
          function hasLightHero() {
            var hero =
              document.querySelector('main .lh_hero') ||
              document.querySelector('main .lh_blog-hero') ||
              document.querySelector('main .section_small-hero') ||
              document.querySelector('main header');
            if (!hero) return false;
            if (hero.classList.contains('lh_light-hero') || hero.classList.contains('lh_blog-hero')) {
              return true;
            }
            var bg = window.getComputedStyle(hero).backgroundColor;
            var rgb = parseRgb(bg);
            if (!rgb || rgb.a === 0) return false;
            return luminance(rgb) >= 0.66;
          }
          var forceScrolled =
            html.classList.contains('lh_product') ||
            html.classList.contains('lh_nav_solid') ||
            hasLightHero();
          var threshold = 48;
          function update() {
            if (forceScrolled) {
              bar.classList.add('is-scrolled');
              return;
            }
            bar.classList.toggle('is-scrolled', window.scrollY > threshold);
          }
          update();
          if (!forceScrolled) {
            window.addEventListener('scroll', update, { passive: true });
          }
