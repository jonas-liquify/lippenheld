<script src="{{ 'li_custom.js' | asset_url }}" type="text/javascript"></script>
<div li-element="product-variant-container" class="product-item_component" x-data="handleVariant({{ product | json | escape }}, {{ product.options_by_name | json | escape }}, {{ product.selected_or_first_available_variant | json | escape }})" x-init="$nextTick(() => { activateVariants() })" @setbundleitem.window="updateBundleItem($event.detail.product, $event.detail.quantity)"><div class="product-item_image-link"><a li-object:href="product.url" href="{{ product.url }}" aria-label="{{ product.title }}" class="product-item_image-wrapper"><img src="{{ product.featured_image | image_url: width: 600 }}" loading="lazy" alt="{{ product.featured_image.alt }}" li-object:src="product.featured_image | image_url: width: 600" li-object:alt="product.featured_image.alt" class="product-item_image"></a><div class="product-item_tag_list">{% if product.tags contains 'Bestseller' %}    <div li-if="product.tags contains 'Bestseller'" class="product-item_tag">
    Bestseller    </div>
{% endif %}{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price" class="product-item_tag is-red">
    Sale    </div>
{% endif %}{% if product.selected_or_first_available_variant.available != true %}    <div li-if="product.selected_or_first_available_variant.available != true" class="product-item_tag">
    Ausverkauft    </div>
{% endif %}</div><div class="product-item_form-wrapper">{% if product.available == true %}    <div li-if="product.available == true">
    <a li-element="add-to-cart" href="#" class="button is-white max-width-full" @click="addToCart($event, true)" :disabled="!addToCartButton">In den Warenkorb</a>    </div>
{% endif %}{% if product.available != true %}    <div li-if="product.available != true">
    <a href="#" class="button is-white pointer-events-off max-width-full">Ausverkauft</a>    </div>
{% endif %}</div></div><a li-object:href="product.url" href="{{ product.url }}" class="product-item_text-link"><div class="stars_wrapper"><div class="stars_list"><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 10 10" fill="currentColor"><path d="M5 0l1.24 3.45H10L7.06 5.6 8.18 9 5 6.9 1.82 9l1.12-3.4L0 3.45h3.76L5 0z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 10 10" fill="currentColor"><path d="M5 0l1.24 3.45H10L7.06 5.6 8.18 9 5 6.9 1.82 9l1.12-3.4L0 3.45h3.76L5 0z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 10 10" fill="currentColor"><path d="M5 0l1.24 3.45H10L7.06 5.6 8.18 9 5 6.9 1.82 9l1.12-3.4L0 3.45h3.76L5 0z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 10 10" fill="currentColor"><path d="M5 0l1.24 3.45H10L7.06 5.6 8.18 9 5 6.9 1.82 9l1.12-3.4L0 3.45h3.76L5 0z"></path></svg><svg xmlns="http://www.w3.org/2000/svg" viewbox="0 0 10 10" fill="currentColor"><path d="M5 0l1.24 3.45H10L7.06 5.6 8.18 9 5 6.9 1.82 9l1.12-3.4L0 3.45h3.76L5 0z"></path></svg></div><div class="stars_value">4.9</div></div><div class="product-item_left"><div li-object="product.title" class="product-item_title">{{ product.title }}</div><div li-object="product.vendor" class="product-item_vendor">{{ product.vendor }}</div></div><div class="product-item_price">{% if product.compare_at_price_max > product.price %}    <div li-if="product.compare_at_price_max > product.price">
    <span li-object="product.compare_at_price | money" class="text-style-strikethrough text-style-muted">{{ product.compare_at_price | money }}</span>    </div>
{% endif %}<span li-object="product.price | money">{{ product.price | money }}</span></div></a></div>
