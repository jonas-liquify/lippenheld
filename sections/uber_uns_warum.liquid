<div class="padding-global lh_section_layout" style="{% if section.settings.bg_color != blank %}--lh-sec-bg: {{ section.settings.bg_color }};{% endif %}--lh-sec-pt: {{ section.settings.padding_top }}px;--lh-sec-pb: {{ section.settings.padding_bottom }}px;--lh-sec-px: {{ section.settings.padding_x }}px;"><div class="container-large">{% for block in section.blocks %}
    {% if block.type == "warum-kopf" %}
                    <div class="lh_about_why_head" li-block="_Warum Kopf" li-block:category="Kopf">
                                    <p class="lh_about_eyebrow">
{{ block.settings.text_kicker }}
</p>
                                    <h2 class="lh_kicker">
{{ block.settings.text_uberschrift }}
</h2>
                                    <div class="lh_text_playfair"> {{ block.settings.richtext_text }} </div>
                            </div>
            {% endif %}
{% endfor %}<div class="lh_about_why_grid" li-content-for-theme-blocks="">
{% content_for 'blocks' %}
</div></div></div> {% schema %} {
    "tag": "section",
    "name": "\u00dcber uns Warum",
    "class": "lh_about_why",
    "blocks": [
        {
            "type": "_warum-kachel"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_x",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand links\/rechts",
            "default": 60
        }
    ],
    "presets": [
        {
            "name": "\u00dcber uns Warum",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "_warum-kopf"
                },
                {
                    "type": "_warum-kachel"
                },
                {
                    "type": "_warum-kachel"
                },
                {
                    "type": "_warum-kachel"
                },
                {
                    "type": "_warum-kachel"
                }
            ]
        }
    ]
} {% endschema %}