<div class="padding-global padding-section is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-left is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container"><div class="header-block_component"><h1 class="heading-style-h1">
{{ section.settings.text_uberschrift }}
</h1></div><div class="spacer-large"></div>{% if cart.item_count > 0 %}    <div li-if="cart.item_count > 0" class="cart_layout">
    {% form 'cart', class: 'cart_list' %}
{% for item in cart.items %}    <div li-for="item in cart.items" class="cart_row">
                                    <div class="cart_row-media"><a li-object:href="item.url" href="{{ item.url }}" aria-label="Produkt ansehen"><img src="{{ item.image | image_url: width: 300 }}" loading="lazy" alt="{{ item.title }}" li-object:src="item.image | image_url: width: 300" li-object:alt="item.title"></a></div>
                            <div class="cart_row-info"><a li-object:href="item.url" href="{{ item.url }}"><div li-object="item.product.title" class="product-item_title">{{ item.product.title }}</div></a><div li-object="item.product.vendor" class="product-item_vendor">{{ item.product.vendor }}</div><div li-object="item.variant.title" class="text-size-small text-style-muted">{{ item.variant.title }}</div></div>
                            <div class="cart_row-actions"><div class="quantity_wrapper"><a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | minus: 1 }}" class="quantity_button">-</a><input class="quantity_input" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a href="/cart/change?line={{ forloop.index }}&quantity={{ item.quantity | plus: 1 }}" class="quantity_button">+</a></div><div li-object="item.final_line_price | money" class="product-header_price">{{ item.final_line_price | money }}</div><a href="/cart/change?line={{ forloop.index }}&quantity=0" class="mini-cart_line-item_remove" aria-label="Entfernen"><svg viewbox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M2.5 4.5h11M6.5 4.5V3h3v1.5M4 4.5l.7 9h6.6l.7-9M6.5 7v4M9.5 7v4" stroke="currentColor" stroke-width="1.1" fill="none"></path></svg></a></div>
                        </div>
{% endfor %}{% endform %}{% content_for "block", type: "warenkorb-summe", id: "warenkorb-summe" %}    </div>
{% endif %}{% if cart.item_count == 0 %}    <div li-if="cart.item_count == 0" class="cart_empty">
    <div class="heading-style-h3">
{{ section.settings.text_leer_text }}
</div><a li-object:href="routes.all_products_collection_url" href="{{ routes.all_products_collection_url }}" class="button"><span>
{{ section.settings.text_leer_button }}
</span></a>    </div>
{% endif %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Cart",
    "class": "section_cart",
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Warenkorb"
        },
        {
            "id": "text_versand_label",
            "type": "text",
            "label": "Versand-Label",
            "default": "Versand"
        },
        {
            "id": "text_versand_wert",
            "type": "text",
            "label": "Versand-Wert",
            "default": "Kostenlos"
        },
        {
            "id": "text_checkout_button",
            "type": "text",
            "label": "Checkout-Button",
            "default": "Sicher zur Kasse"
        },
        {
            "id": "richtext_hinweis",
            "type": "richtext",
            "label": "Hinweis",
            "default": "<p>Versandkosten und Rabatte werden im n\u00e4chsten Schritt berechnet.<\/p>"
        },
        {
            "id": "text_leer_text",
            "type": "text",
            "label": "Leer-Text",
            "default": "Dein Warenkorb ist noch leer."
        },
        {
            "id": "text_leer_button",
            "type": "text",
            "label": "Leer-Button",
            "default": "Jetzt entdecken"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "white"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "large"
        }
    ],
    "presets": [
        {
            "name": "Cart",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "warenkorb-summe",
                    "static": true,
                    "id": "warenkorb-summe"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "cart"
        ]
    }
} {% endschema %}