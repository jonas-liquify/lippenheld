<div class="padding-global lh_section_layout" style="{% if section.settings.bg_color != blank %}--lh-sec-bg: {{ section.settings.bg_color }};{% endif %}--lh-sec-pt: {{ section.settings.padding_top }}px;--lh-sec-pb: {{ section.settings.padding_bottom }}px;--lh-sec-px: {{ section.settings.padding_x }}px;">
          <div class="container-large">
            <div class="lh_wirkung_products_grid" li-content-for-theme-blocks="">
{% content_for 'blocks' %}
</div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Wirkung Produkte",
    "class": "lh_wirkung_products",
    "blocks": [
        {
            "type": "_produkte-intro"
        },
        {
            "type": "_produkt-karte"
        },
        {
            "type": "_produkt-karte-atc"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Hintergrundfarbe",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_x",
            "min": 0,
            "max": 120,
            "step": 4,
            "unit": "px",
            "label": "Abstand links\/rechts",
            "default": 60
        },
        {
            "type": "collection",
            "id": "highlight_collection",
            "label": "Kollektion f\u00fcr Button",
            "info": "Optional: verlinkt den CTA zuerst hierher."
        },
        {
            "type": "url",
            "id": "button_url",
            "label": "Button Link"
        }
    ],
    "presets": [
        {
            "name": "Wirkung Produkte",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "_produkte-intro"
                },
                {
                    "type": "_produkt-karte"
                },
                {
                    "type": "_produkt-karte-atc"
                }
            ]
        }
    ]
} {% endschema %}