<div class="login_component"><div class="arc-label_wrapper"><svg class="arc-label" viewbox="0 0 140 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path id="arc-password-bald-verfuegbar" d="M4 32 Q70 0 136 32" fill="none" stroke="none"></path><text class="arc-label_text"><textpath href="#arc-password-bald-verfuegbar" startoffset="50%" text-anchor="middle" href="#arc-password-bald-verfuegbar">
{{ section.settings.text_subline }}
</textpath></text></svg></div><h1 class="heading-style-h1">
{{ section.settings.text_uberschrift }}
</h1><div class="text-size-regular"> {{ section.settings.richtext_text }} </div>{% form 'storefront_password', class: 'form_component' %}
<div class="form_field-wrapper"><label for="password-input" class="form_label">Passwort</label><input class="form_input" type="password" id="password-input" name="password" placeholder="Passwort" required=""></div><div class="spacer-medium"></div><input type="submit" class="button max-width-full" value="Shop betreten">{% endform %}</div> {% schema %} {
    "tag": "section",
    "name": "Password",
    "class": "section_under-construction",
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Bald verf\u00fcgbar"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Wir sind gleich f\u00fcr dich da"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>Unser Shop \u00f6ffnet in K\u00fcrze.<\/p>"
        }
    ],
    "presets": [
        {
            "name": "Password",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "password"
        ]
    }
} {% endschema %}