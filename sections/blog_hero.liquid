{% for forloop.first %}    <div class="lh_blog-hero_item" li-for="article in blog.articles" li-if="forloop.first">
                                    
          
                            <div class="lh_blog-hero_media">
            <img class="lh_blog-hero_image" src="{{ article.image | image_url: width: 1200 }}" loading="lazy" alt="{{ article.image.alt }}" li-object:src="article.image | image_url: width: 1200" li-object:alt="article.image.alt">
          </div>
                            
          
                            <div class="lh_blog-hero_content">
            <div class="lh_blog-hero_chips">
              <div class="lh_blog-chip">NEU</div>
              {% if article.tags.size > 0 %}    <div class="lh_blog-chip" li-if="article.tags.size > 0" li-object:content="article.tags.first" content="article.tags.first">
    Kategorie    </div>
{% endif %}
            </div>
            <h1 class="lh_blog-hero_title" li-object:content="article.title" content="{{ article.title }}">Prävention beginnt schon früh, Lippenpflege für alle Altersgruppen?</h1>
            <p class="lh_blog-hero_excerpt" li-object:content="article.excerpt | strip_html | truncate: 220" content="{{ article.excerpt | strip_html | truncate: 220 }}">Du bist auf der Suche nach einem Anti-Aging-Wirkstoff, der natürlich und effektiv funktioniert?</p>
            <div class="lh_blog-hero_meta">
              <span class="lh_blog-meta_text" li-object:content="article.published_at | date: '%d. %B %Y'" content="{{ article.published_at | date: '%d. %B %Y' }}">23. Oktober 2025</span>
               
              <span class="lh_blog-meta_dot"></span>
               
              <span class="lh_blog-meta_text" li-object:content="article.content | strip_html | size | divided_by: 850 | at_least: 1 | append: ' min'" content="{{ article.content | strip_html | size | divided_by: 850 | at_least: 1 | append: ' min' }}">5 min</span>
            </div>
            <a class="lh_blog-hero_cta" href="{{ article.url }}" li-object:href="article.url">
              <span>JETZT LESEN</span>
            </a>
          </div>
                            
        
                        </div>
{% endfor %} {% schema %} {
    "tag": "header",
    "name": "Blog-Hero",
    "class": "lh_blog-hero",
    "presets": [
        {
            "name": "Blog-Hero",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}