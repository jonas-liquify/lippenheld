<div class="padding-global padding-section-small is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-{{ section.settings.content_align }} is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container"><div class="page-hero_component"><h1 li-object="blog.title" class="heading-style-h1">{{ blog.title }}</h1><div class="text-size-regular max-width-large"> {{ section.settings.richtext_text }} </div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Blog-Hero",
    "class": "section_page-hero",
    "settings": [
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>Wissen rund um Lippenpflege, Oliven-Antioxidantien und die Menschen hinter Lippenheld.<\/p>"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 24
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "white"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "large"
        },
        {
            "type": "select",
            "id": "content_align",
            "label": "Ausrichtung",
            "options": [
                {
                    "value": "left",
                    "label": "Links"
                },
                {
                    "value": "center",
                    "label": "Zentriert"
                },
                {
                    "value": "right",
                    "label": "Rechts"
                }
            ],
            "default": "left"
        }
    ],
    "presets": [
        {
            "name": "Blog-Hero",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}