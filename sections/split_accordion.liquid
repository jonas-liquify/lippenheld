<div class="padding-global is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-left is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container"><div class="split_component{% if section.settings.media_position == 'right' %} is-reversed{% endif %}"><div class="split_media">{% if section.settings.image_bild %}
{{ section.settings.image_bild | image_url: width: 1400 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="">
{% endif %}</div><div class="split_content"><div class="split_header"><div class="arc-label_wrapper"><svg class="arc-label" viewbox="0 0 140 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path id="arc-split-accordion-warum-lippenheld" d="M4 32 Q70 0 136 32" fill="none" stroke="none"></path><text class="arc-label_text"><textpath href="#arc-split-accordion-warum-lippenheld" startoffset="50%" text-anchor="middle" href="#arc-split-accordion-warum-lippenheld">
{{ section.settings.text_subline }}
</textpath></text></svg></div><h2 class="heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2></div><div li-content-for-theme-blocks="" class="accordion_list is-large">
{% content_for 'blocks' %}
</div></div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Split Accordion",
    "class": "section_split",
    "blocks": [
        {
            "type": "split-akkordeon"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Warum Lippenheld?"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Das st\u00e4rkste Antioxidans aus Aqua Mora. 100% nat\u00fcrliche Bestandteile"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 0
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "none"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "ocean"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "select",
            "id": "media_position",
            "label": "Bildposition",
            "options": [
                {
                    "value": "left",
                    "label": "Links"
                },
                {
                    "value": "right",
                    "label": "Rechts"
                }
            ],
            "default": "left"
        }
    ],
    "presets": [
        {
            "name": "Split Accordion",
            "category": "Content",
            "blocks": [
                {
                    "type": "split-akkordeon"
                }
            ]
        }
    ]
} {% endschema %}