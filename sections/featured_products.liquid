<div class="padding-global padding-section is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-left is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --product-columns: {{ section.settings.columns }};"><div class="container"><div class="featured_component"><div class="featured_intro"><div class="arc-label_wrapper"><svg class="arc-label" viewbox="0 0 140 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path id="arc-featured-products-lippenheld" d="M4 32 Q70 0 136 32" fill="none" stroke="none"></path><text class="arc-label_text"><textpath href="#arc-featured-products-lippenheld" startoffset="50%" text-anchor="middle" href="#arc-featured-products-lippenheld">
{{ section.settings.text_subline }}
</textpath></text></svg></div><h2 class="heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div class="text-size-regular max-width-small align-center"> {{ section.settings.richtext_text }} </div><div class="button-group"><a href="{{ section.settings.url_button_link }}" class="button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div>{% for product in section.settings.collection_kollektion.products limit: section.settings.collection_kollektion_limit %}
<div class="featured_list">
    {% render 'product_item', product: product %}
</div>
{% endfor %}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Featured Products",
    "class": "section_featured-products",
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Lippenheld"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Regeneriert, sch\u00fctzt und pflegt die Lippen"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>Lippenheld sch\u00fctzt &amp; pflegt, n\u00e4hrt &amp; regeneriert. Naturrein und liebevoll gewonnen.<\/p>"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "Jetzt entdecken"
        },
        {
            "id": "collection_kollektion",
            "type": "collection",
            "label": "Kollektion"
        },
        {
            "type": "range",
            "id": "collection_kollektion_limit",
            "min": 1,
            "max": 99,
            "step": 1,
            "label": "Limit: Kollektion",
            "default": 6
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "white"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "full"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns",
            "min": 1,
            "max": 4,
            "step": 1,
            "label": "Produkte pro Reihe",
            "default": 2
        }
    ],
    "presets": [
        {
            "name": "Featured Products",
            "category": "Produkte",
            "blocks": []
        }
    ]
} {% endschema %}