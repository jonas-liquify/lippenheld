<div class="padding-global padding-section-small is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-center is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --usp-columns: {{ section.settings.columns }};"><div class="container"><div li-content-for-theme-blocks="" class="usp-icons_list">
{% content_for 'blocks' %}
</div></div></div> {% schema %} {
    "tag": "section",
    "name": "USP Icons",
    "class": "section_usp-icons",
    "blocks": [
        {
            "type": "usp-icon"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 60
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 60
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "paper"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "large"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns",
            "min": 2,
            "max": 6,
            "step": 1,
            "label": "Icons pro Reihe",
            "default": 5
        }
    ],
    "presets": [
        {
            "name": "USP Icons",
            "category": "Content",
            "blocks": [
                {
                    "type": "usp-icon"
                }
            ]
        }
    ]
} {% endschema %}