<div class="padding-global">
          <div class="container-large lh_faq_layout">
            <div class="lh_faq_content">
              {% for block in section.blocks %}
    {% if block.type == "faq-kategorie" %}
                    <div class="lh_faq_group" id="faq-produkt" data-lh-faq-group="" li-block="_FAQ Kategorie" li-block:category="FAQ">
                                    
                
                                    <h2 class="lh_faq_group_title">
{{ block.settings.text_kategorie_titel }}
</h2>
                                    
                
                                    <div class="lh_faq_list" li-content-for-theme-blocks="">
