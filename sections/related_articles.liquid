<div class="padding-global">
          <div class="lh_blog-shell lh_article-related container-large">
            {% assign currentArticle = article.title %}
            <h2 class="lh_blog-list_title">
{{ section.settings.text_heading }}
</h2>
            <div class="lh_blog-grid" li-for:inside="related_article in blog.articles limit: 4" role="list">
        {% for related_article in blog.articles limit: 4 %}                            
              
                            {% if related_article.title != currentArticle %}    <article class="lh_blog-card" li-if="related_article.title != currentArticle" role="listitem">
    
                <a class="lh_blog-card_link" href="{{ related_article.url }}" li-object:href="related_article.url">
                  <img class="lh_blog-card_image" src="{{ related_article.image | image_url: width: 900 }}" loading="lazy" alt="{{ related_article.image.alt }}" li-object:src="related_article.image | image_url: width: 900" li-object:alt="related_article.image.alt">
                  <div class="lh_blog-card_copy">
                    {% if related_article.tags.size > 0 %}    <div class="lh_blog-chip is-small" li-if="related_article.tags.size > 0" li-object:content="related_article.tags.first" content="related_article.tags.first">
    Category 1    </div>
{% endif %}
                    <h3 class="lh_blog-card_title" li-object:content="related_article.title" content="{{ related_article.title }}">Haut ab 40: Darum ist Hydroxytyrosol der neue Wunder-Wirkstoff</h3>
                    <p class="lh_blog-card_excerpt" li-object:content="related_article.excerpt | strip_html | truncate: 160" content="{{ related_article.excerpt | strip_html | truncate: 160 }}">Du bist auf der Suche nach einem Anti-Aging-Wirkstoff, der natuerlich und effektiv funktioniert?</p>
                  </div>
                </a>
                  </article>
{% endif %}
                            
            
                    {% endfor %}    </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Related Articles",
    "class": "section_related-articles",
    "settings": [
        {
            "id": "text_heading",
            "type": "text",
            "label": "Heading",
            "default": "Weitere Artikel"
        }
    ],
    "presets": [
        {
            "name": "Related Articles",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "article"
        ]
    }
} {% endschema %}