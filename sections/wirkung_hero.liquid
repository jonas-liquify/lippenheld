<div class="lh_wirkung_hero_bg" aria-hidden="true">
          {% if section.settings.image_hero_hintergrund %}
{{ section.settings.image_hero_hintergrund | image_url: width: 1000 | image_tag: class: 'lh_wirkung_hero_bg_img', loading: 'eager' }}
{% else %}
<img class="lh_wirkung_hero_bg_img" src="{{ 'lh-hero-bg.jpg' | asset_url }}" loading="eager" alt="">
{% endif %}
          <div class="lh_wirkung_hero_bg_overlay"></div>
        </div>
        <div class="padding-global lh_wirkung_hero_inner">
          <div class="container-large">
            <div class="lh_wirkung_hero_copy">
              <h1 class="lh_wirkung_hero_title">
{{ section.settings.text_uberschrift }}
</h1>
              <div class="lh_wirkung_hero_lead lh_text_playfair"> {{ section.settings.richtext_einleitung }} </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "Wirkung Hero",
    "class": "lh_wirkung_hero lh_light-hero",
    "settings": [
        {
            "id": "image_hero_hintergrund",
            "type": "image_picker",
            "label": "Hero Hintergrund"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Sch\u00f6ne Lippen soll man k\u00fcssen , aber nicht nur zum K\u00fcssen sind sie da."
        },
        {
            "id": "richtext_einleitung",
            "type": "richtext",
            "label": "Einleitung",
            "default": "<p>Porem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis.Porem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis.<\/p>"
        }
    ],
    "presets": [
        {
            "name": "Wirkung Hero",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}