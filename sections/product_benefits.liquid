<div class="padding-global padding-section is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-center is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container"><div class="benefits_component"><div class="benefits_header"><div class="arc-label_wrapper"><svg class="arc-label" viewbox="0 0 140 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path id="arc-product-benefits-warum-lippenheld" d="M4 32 Q70 0 136 32" fill="none" stroke="none"></path><text class="arc-label_text"><textpath href="#arc-product-benefits-warum-lippenheld" startoffset="50%" text-anchor="middle" href="#arc-product-benefits-warum-lippenheld">
{{ section.settings.text_subline }}
</textpath></text></svg></div><h2 class="heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2></div><div class="benefits_stage"><div li-content-for-theme-blocks="" class="benefits_column">
{% content_for 'blocks' %}
</div><div class="benefits_media">{% if section.settings.image_produktbild %}
{{ section.settings.image_produktbild | image_url: width: 1200 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="">
{% endif %}</div>{% content_for "block", type: "vorteile-rechts", id: "vorteile-rechts" %}</div>{% content_for "block", type: "vorteile-cta", id: "vorteile-cta" %}</div></div></div> {% schema %} {
    "tag": "section",
    "name": "Product Benefits",
    "class": "section_benefits",
    "blocks": [
        {
            "type": "produktvorteil"
        },
        {
            "type": "produktvorteil-rechts"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Warum Lippenheld?"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Warum Lippenheld so wertvoll f\u00fcr deine Lippen ist"
        },
        {
            "id": "image_produktbild",
            "type": "image_picker",
            "label": "Produktbild"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "In den Warenkorb"
        },
        {
            "id": "richtext_hinweis",
            "type": "richtext",
            "label": "Hinweis",
            "default": "<p>Verdiene <strong>1.199 Punkte<\/strong> mit diesem Einkauf<\/p>"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "sand"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "large"
        }
    ],
    "presets": [
        {
            "name": "Product Benefits",
            "category": "Content",
            "blocks": [
                {
                    "type": "produktvorteil"
                },
                {
                    "type": "vorteile-rechts",
                    "static": true,
                    "id": "vorteile-rechts",
                    "blocks": [
                        {
                            "type": "produktvorteil-rechts"
                        }
                    ]
                },
                {
                    "type": "vorteile-cta",
                    "static": true,
                    "id": "vorteile-cta"
                }
            ]
        }
    ]
} {% endschema %}