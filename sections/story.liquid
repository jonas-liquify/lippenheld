<div class="story_component is-theme-transparent" style="min-height: {{ section.settings.min_height }}px; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="story_media">{% if section.settings.image_hintergrundbild %}
{{ section.settings.image_hintergrundbild | image_url: width: 2400 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="">
{% endif %}</div><div class="hero_overlay" style="opacity: {{ section.settings.overlay_strength | divided_by: 100.0 }};"></div><div class="story_content"><div class="story_badge">{% if section.settings.image_siegel %}
{{ section.settings.image_siegel | image_url: width: 200 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="">
{% endif %}</div><h2 class="heading-style-h2">
{{ section.settings.text_uberschrift }}
</h2><div class="text-size-regular"> {{ section.settings.richtext_text }} </div><div class="button-group"><a href="{{ section.settings.url_button_link }}" class="button"> <span>{{ section.settings.text_button_text }}</span> </a></div></div></div>{% if section.settings.header_overlay %}    <div li-if="section.settings.header_overlay" class="header-overlay">
    {% render 'header_overlay' %}    </div>
{% endif %} {% schema %} {
    "tag": "section",
    "name": "Story",
    "class": "section_story",
    "settings": [
        {
            "id": "image_hintergrundbild",
            "type": "image_picker",
            "label": "Hintergrundbild"
        },
        {
            "id": "image_siegel",
            "type": "image_picker",
            "label": "Siegel"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Aqua Mora und der Wirkstoff Hydroxytyrosol"
        },
        {
            "id": "richtext_text",
            "type": "richtext",
            "label": "Text",
            "default": "<p>Es klingt wie ein toskanisches M\u00e4rchen, das jetzt wahr wurde. Von Generation zu Generation wurde es m\u00fcndlich weitergegeben: Das aus der Olive gewonnene Aqua Mora ist ein gesundheitsf\u00f6rdernder Trunk, der von den alten Toskanerinnen nach der Olivenernte getrunken wurde. Viele Generationen setzten auf das alte Geheimnis, ohne zu wissen, was dahintersteckt.<\/p>"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "Jetzt entdecken"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 80
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "checkbox",
            "id": "header_overlay",
            "label": "Header transparent dar\u00fcberlegen",
            "info": "Legt die Navigation ohne Hintergrund \u00fcber diesen Bereich. Beim Scrollen wird sie automatisch wei\u00df.",
            "default": false
        },
        {
            "type": "range",
            "id": "min_height",
            "min": 300,
            "max": 1000,
            "step": 20,
            "unit": "px",
            "label": "Mindesth\u00f6he",
            "default": 800
        },
        {
            "type": "range",
            "id": "overlay_strength",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "label": "Overlay-St\u00e4rke",
            "default": 0
        }
    ],
    "presets": [
        {
            "name": "Story",
            "category": "Content",
            "blocks": []
        }
    ]
} {% endschema %}