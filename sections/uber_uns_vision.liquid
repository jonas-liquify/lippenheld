<div class="lh_about_vision_bg" aria-hidden="true">{% if section.settings.image_hintergrund %}
{{ section.settings.image_hintergrund | image_url: width: 1000 | image_tag: class: 'lh_about_vision_bg_img', loading: 'eager' }}
{% else %}
<img class="lh_about_vision_bg_img" src="{{ 'lh-hero-bg.jpg' | asset_url }}" loading="eager" alt="">
{% endif %}<div class="lh_about_vision_bg_overlay"></div></div><div class="padding-global lh_about_vision_inner"><div class="container-large"><div class="lh_about_vision_copy"><p class="lh_about_eyebrow">
{{ section.settings.text_kicker }}
</p><h1 class="lh_about_vision_quote">
{{ section.settings.text_vision_zitat }}
</h1><div class="lh_about_vision_lead lh_text_playfair"> {{ section.settings.richtext_vision_text }} </div></div><div class="lh_about_vision_stats" li-content-for-theme-blocks="">
{% content_for 'blocks' %}
</div></div></div> {% schema %} {
    "tag": "section",
    "name": "\u00dcber uns Vision",
    "class": "lh_about_vision lh_light-hero",
    "blocks": [
        {
            "type": "_vision-stat"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "image_hintergrund",
            "type": "image_picker",
            "label": "Hintergrund"
        },
        {
            "id": "text_kicker",
            "type": "text",
            "label": "Kicker",
            "default": "unser vision"
        },
        {
            "id": "text_vision_zitat",
            "type": "text",
            "label": "Vision Zitat",
            "default": "\u201ePflege mit medizinischem Nutzen zu verbinden.\u201c"
        },
        {
            "id": "richtext_vision_text",
            "type": "richtext",
            "label": "Vision Text",
            "default": "<p>Mit \u00fcber 35 Jahren Erfahrung in Naturmedizin, Pflanzenheilkunde und Biokosmetik entwickelte ich Lippenheld aus pers\u00f6nlicher Frustration \u2013 weil kein Produkt meinen Anspr\u00fcchen an Schutz, Regeneration, Reinheit und Wirksamkeit gerecht wurde.<\/p>"
        }
    ],
    "presets": [
        {
            "name": "\u00dcber uns Vision",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "_vision-stat"
                },
                {
                    "type": "_vision-stat"
                },
                {
                    "type": "_vision-stat"
                }
            ]
        }
    ]
} {% endschema %}