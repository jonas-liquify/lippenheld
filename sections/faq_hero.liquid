<div class="lh_faq_hero_bg" aria-hidden="true">
          {% if section.settings.image_hero_hintergrund %}
{{ section.settings.image_hero_hintergrund | image_url: width: 1000 | image_tag: class: 'lh_faq_hero_bg_img', loading: 'eager' }}
{% else %}
<img class="lh_faq_hero_bg_img" src="{{ 'lh-hero-bg.jpg' | asset_url }}" loading="eager" alt="">
{% endif %}
          <div class="lh_faq_hero_bg_overlay"></div>
        </div>
        <div class="padding-global lh_faq_hero_inner">
          <div class="container-large">
            <div class="lh_faq_hero_copy">
              <p class="lh_faq_hero_kicker">
{{ section.settings.text_kicker }}
</p>
              <h1 class="lh_faq_hero_title">
{{ section.settings.text_uberschrift }}
</h1>
              <div class="lh_faq_hero_lead lh_text_playfair"> {{ section.settings.richtext_einleitung }} </div>
            </div>
          </div>
        </div> {% schema %} {
    "tag": "section",
    "name": "FAQ Hero",
    "class": "lh_faq_hero",
    "settings": [
        {
            "id": "image_hero_hintergrund",
            "type": "image_picker",
            "label": "Hero Hintergrund"
        },
        {
            "id": "text_kicker",
            "type": "text",
            "label": "Kicker",
            "default": "FAQ"
        },
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Du hast Fragen? Wir helfen gern."
        },
        {
            "id": "richtext_einleitung",
            "type": "richtext",
            "label": "Einleitung",
            "default": "<p>Porem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis<\/p>"
        }
    ],
    "presets": [
        {
            "name": "FAQ Hero",
            "category": "Liquify",
            "blocks": []
        }
    ]
} {% endschema %}