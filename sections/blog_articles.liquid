{% paginate blog.articles by 9 %}
    <div class="lh_blog-shell container-large" li-paginate:by="9" li-paginate="blog.articles" by="9">
          <div class="lh_blog-list_head">
            <div class="lh_blog-list_intro">
              <h2 class="lh_blog-list_title" li-object:content="blog.title" content="{{ blog.title }}">LIPPENHELD BLOG</h2>
              <p class="lh_blog-list_description">Insights rund um Lippenpflege, Wirkstoffe und echte Ergebnisse aus der Lippenheld Welt.</p>
            </div>
            <div class="lh_blog-list_filters">
              <a class="lh_blog-filter is-active" href="{{ blog.url }}" li-object:href="blog.url">
                <span>SHOW ALL</span>
                 
                <span class="lh_blog-filter_count" li-object:content="blog.articles_count" content="{{ blog.articles_count }}">[89]</span>
                 
              </a>
               
              {% for tag in blog.all_tags | limit: 2 %}    <a class="lh_blog-filter" href="#" li-for="tag in blog.all_tags | limit: 2" li-object:href="blog.url | append: '/tagged/' | append: tag">
                                    
                 
                
                            <span li-object:content="tag" content="{{ tag }}">Category 1</span>
                            
                 
                
                            <span class="lh_blog-filter_count">[ ]</span>
                            
              
                        </a>
{% endfor %}
            </div>
          </div>
          {% if blog.articles != blank %}    <div class="lh_blog-grid" li-if="blog.articles != blank" role="list">
    
            {% for forloop.first %}    <article class="lh_blog-card" li-for="article in blog.articles" li-unless="forloop.first" role="listitem">
                                    
              
                            <a class="lh_blog-card_link" href="{{ article.url }}" li-object:href="article.url">
                <img class="lh_blog-card_image" src="{{ article.image | image_url: width: 900 }}" loading="lazy" alt="{{ article.image.alt }}" li-object:src="article.image | image_url: width: 900" li-object:alt="article.image.alt">
                <div class="lh_blog-card_copy">
                  {% if article.tags.size > 0 %}    <div class="lh_blog-chip is-small" li-if="article.tags.size > 0" li-object:content="article.tags.first" content="article.tags.first">
    Category 1    </div>
{% endif %}
                  <h3 class="lh_blog-card_title" li-object:content="article.title" content="{{ article.title }}">Prävention beginnt schon früh, Lippenpflege für alle Altersgruppen?</h3>
                  <p class="lh_blog-card_excerpt" li-object:content="article.excerpt | strip_html | truncate: 160" content="{{ article.excerpt | strip_html | truncate: 160 }}">Du bist auf der Suche nach einem Anti-Aging-Wirkstoff, der natürlich und effektiv funktioniert?</p>
                </div>
              </a>
                            
            
                        </article>
{% endfor %}
              </div>
{% endif %}
          {% if blog.articles == blank %}    <div class="blog_cms-empty w-dyn-empty" li-if="blog.articles == blank">
    
            <div>Keine Blogbeitraege gefunden.</div>
              </div>
{% endif %}
          {% if paginate.pages > 1 %}    <nav class="pagination_component" li-if="paginate.pages > 1">
    
            <ul class="pagination_list w-list-unstyled" role="list">
              {% if paginate.previous %}    <li class="pagination_item" li-if="paginate.previous">
    
                <a class="button is-secondary is-icon w-inline-block" li-object:href="paginate.previous.url" href="{{ paginate.previous.url }}">
                  <div class="pagination_arrow w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path>
                    </svg>
                  </div>
                  <div>Back</div>
                </a>
                  </li>
{% endif %}
              {% if paginate.previous == false %}    <li class="pagination_item" li-if="paginate.previous == false">
    
                <a class="button is-secondary is-icon text-style-muted pointer-events-off w-inline-block" li-object:href="paginate.previous.url" href="{{ paginate.previous.url }}">
                  <div class="pagination_arrow w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path>
                    </svg>
                  </div>
                  <div>Back</div>
                </a>
                  </li>
{% endif %}
              {% for part in paginate.parts %}    <li class="pagination_item" li-for="part in paginate.parts">
                                    
                
                            {% if part.is_link %}    <div li-if="part.is_link">
    
                  <a class="pagination_count w-inline-block" li-object:href="part.url" href="{{ part.url }}">
                    <div class="text-style-link" li-object="part.title">{{ part.title }}</div>
                  </a>
                    </div>
{% endif %}
                            
                
                            {% if part.is_link == false %}    <div li-if="part.is_link == false">
    
                  <div li-object="part.title" class="{% if part.title == paginate.current_page %}text-weight-semibold{% endif %}">{{ part.title }}</div>
                    </div>
{% endif %}
                            
              
                        </li>
{% endfor %}
              {% if paginate.next == false %}    <li class="pagination_item" li-if="paginate.next == false">
    
                <a class="button is-secondary is-icon text-style-muted pointer-events-off w-inline-block" li-object:href="paginate.next.url" href="{{ paginate.next.url }}">
                  <div>Next</div>
                  <div class="pagination_arrow is-right w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path>
                    </svg>
                  </div>
                </a>
                  </li>
{% endif %}
              {% if paginate.next %}    <li class="pagination_item" li-if="paginate.next">
    
                <a class="button is-secondary is-icon w-inline-block" li-object:href="paginate.next.url" href="{{ paginate.next.url }}">
                  <div>Next</div>
                  <div class="pagination_arrow is-right w-embed">
                    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewbox="0 0 13 8" fill="none" preserveaspectratio="xMidYMid meet" aria-hidden="true" role="img">
                      <path d="M1.67318 0.589844L6.26318 5.16984L10.8532 0.589844L12.2632 1.99984L6.26318 7.99984L0.263184 1.99984L1.67318 0.589844Z" fill="currentColor"></path>
                    </svg>
                  </div>
                </a>
                  </li>
{% endif %}
            </ul>
              </nav>
{% endif %}
        </div>{% endpaginate %} {% schema %} {
    "tag": "section",
    "name": "Blog-Articles",
    "class": "lh_blog-list",
    "presets": [
        {
            "name": "Blog-Articles",
            "category": "Liquify",
            "blocks": []
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}