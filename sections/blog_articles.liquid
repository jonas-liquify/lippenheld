<div class="padding-global padding-section is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-left is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; --blog-columns: {{ section.settings.columns }};"><div class="container">{% paginate blog.articles by 9 %}
    <div li-paginate="blog.articles" li-paginate:by="9" by="9">{% content_for "block", type: "blog-filter", id: "blog-filter" %}<div class="spacer-medium"></div><div class="blog_list">{% for article in blog.articles %}    <div li-for="article in blog.articles" class="blog_list-item">
                                    <a li-object:href="article.url" href="{{ article.url }}" class="blog_item-grid"><div class="blog_media"><img src="{{ article.image | image_url: width: 800 }}" loading="lazy" alt="{{ article.image.alt }}" li-object:src="article.image | image_url: width: 800" li-object:alt="article.image.alt" class="blog_img"></div><div class="blog_info-wrapper"><div li-for:inside="tag in article.tags" class="blog_tag-row">
        {% for tag in article.tags %}                            <div li-object="tag" class="blog_tag">{{ tag }}</div>
                    {% endfor %}    </div><h2 li-object="article.title" class="blog_title">{{ article.title }}</h2><div li-object="article.excerpt_or_content | strip_html | truncate: 160" class="text-size-regular blog_excerpt">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</div></div></a>
                        </div>
{% endfor %}</div>{% if paginate.pages > 1 %}    <div li-if="paginate.pages > 1" class="pagination_wrapper">
    {% for part in paginate.parts %}    <a li-for="part in paginate.parts" li-object:href="part.url" href="#" class="pagination_link">
                                    <span li-object="part.title">{{ part.title }}</span>
                        </a>
{% endfor %}    </div>
{% endif %}</div>{% endpaginate %}</div></div> {% schema %} {
    "tag": "section",
    "name": "Blog-Articles",
    "class": "section_blog",
    "settings": [
        {
            "id": "text_alle_label",
            "type": "text",
            "label": "Alle-Label",
            "default": "Show all"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 24
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 80
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "medium"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "white"
        },
        {
            "type": "select",
            "id": "content_width",
            "label": "Inhaltsbreite",
            "options": [
                {
                    "value": "small",
                    "label": "Schmal"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Breit"
                },
                {
                    "value": "full",
                    "label": "Randlos"
                }
            ],
            "default": "large"
        },
        {
            "type": "header",
            "content": "Layout"
        },
        {
            "type": "range",
            "id": "columns",
            "min": 2,
            "max": 4,
            "step": 1,
            "label": "Artikel pro Reihe",
            "default": 3
        }
    ],
    "presets": [
        {
            "name": "Blog-Articles",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "blog-filter",
                    "static": true,
                    "id": "blog-filter"
                }
            ]
        }
    ],
    "enabled_on": {
        "templates": [
            "blog"
        ]
    }
} {% endschema %}