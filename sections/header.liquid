    <div class="predictive-search_label">Beliebte Suchanfragen</div><div class="predictive-search_tags">{% for query in predictive_search.resources.queries %}    <a li-for="query in predictive_search.resources.queries" li-object:href="query.url" href="#" class="predictive-search_tag">
