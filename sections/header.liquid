    <div class="predictive-search_label">Seiten und Artikel</div><div class="predictive-search_tags">{% for page in predictive_search.resources.pages %}    <a li-for="page in predictive_search.resources.pages" li-object:href="page.url" href="#" class="predictive-search_tag">
