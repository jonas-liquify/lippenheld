<div class="padding-global is-theme-{{ section.settings.color_scheme }} is-width-{{ section.settings.content_width }} is-align-left is-mpad-{{ section.settings.padding_mobile }}" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"><div class="container"><div class="ingredients_layout" x-data="{ active: 0 }"><div class="ingredients_aside"><div><div class="predictive-search_label">
{{ section.settings.text_uberschrift }}
</div><div class="spacer-medium"></div><div li-content-for-theme-blocks="" class="ingredients_list">
{% content_for 'blocks' %}
</div></div>{% content_for "block", type: "inci-liste", id: "inci-liste" %}</div></div></div></div> {% schema %} {
    "tag": "section",
    "name": "Ingredients",
    "class": "section_ingredients",
    "blocks": [
        {
            "type": "inhaltsstoff"
        },
        {
            "type": "@app"
        }
    ],
    "settings": [
        {
            "id": "text_uberschrift",
            "type": "text",
            "label": "\u00dcberschrift",
            "default": "Ingredients"
        },
        {
            "id": "text_inci_titel",
            "type": "text",
            "label": "INCI-Titel",
            "default": "Full Ingredients"
        },
        {
            "id": "richtext_inci_liste",
            "type": "richtext",
            "label": "INCI-Liste",
            "default": "<p>Cera Alba (Beeswax), Theobroma Grandiflorum (Cupuacu) Seed Butter, Polyhydroxystearic Acid, Persea Gratissima (Avocado) Oil, Cannabis Sativa (Hemp) Seed Oil, Simmondsia Chinensis (Jojoba) Seed Oil, Olea Europaea (Olive) Fruit Oil, Tocopherol, Mentha Piperita (Peppermint) Oil.<\/p>"
        },
        {
            "type": "header",
            "content": "Abst\u00e4nde"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand oben",
            "default": 0
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "label": "Abstand unten",
            "default": 0
        },
        {
            "type": "select",
            "id": "padding_mobile",
            "label": "Abstand auf Mobil",
            "options": [
                {
                    "value": "none",
                    "label": "Kein Abstand"
                },
                {
                    "value": "small",
                    "label": "Klein"
                },
                {
                    "value": "medium",
                    "label": "Mittel"
                },
                {
                    "value": "large",
                    "label": "Gro\u00df"
                }
            ],
            "default": "none"
        },
        {
            "type": "header",
            "content": "Darstellung"
        },
        {
            "type": "select",
            "id": "color_scheme",
            "label": "Farbschema",
            "options": [
                {
                    "value": "white",
                    "label": "Wei\u00df"
                },
                {
                    "value": "paper",
                    "label": "Papier"
                },
                {
                    "value": "olive",
                    "label": "Olive"
                },
                {
                    "value": "ocean",
                    "label": "Ocean"
                },
                {
                    "value": "sand",
                    "label": "Sand"
                },
                {
                    "value": "black",
                    "label": "Schwarz"
                },
                {
                    "value": "dark-green",
                    "label": "Dunkelgr\u00fcn"
                }
            ],
            "default": "ocean"
        }
    ],
    "presets": [
        {
            "name": "Ingredients",
            "category": "Content",
            "blocks": [
                {
                    "type": "inhaltsstoff"
                },
                {
                    "type": "inci-liste",
                    "static": true,
                    "id": "inci-liste"
                }
            ]
        }
    ]
} {% endschema %}