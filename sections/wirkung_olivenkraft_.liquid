<div class="lh_split_panel_row">
          {% for block in section.blocks %}
    {% if block.type == "split-text" %}
                    <div class="lh_split_panel_copy is-ocean" li-block="_Split Text" li-block:category="Text">
                                    
            
                                    <h2 class="lh_kicker">
{{ block.settings.text_uberschrift }}
</h2>
                                    
            
                                    <div class="lh_text_playfair"> {{ block.settings.richtext_text }} </div>
                                    
          
                            </div>
            {% endif %}
{% endfor %}
          {% for block in section.blocks %}
    {% if block.type == "split-bild" %}
                    <div class="lh_split_panel_media is-green" li-block="_Split Bild" li-block:category="Medien">
                                    
            
                                    {% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 1000 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'platzhalter.svg' | asset_url }}" alt="" loading="lazy">
{% endif %}
                                    
          
                            </div>
            {% endif %}
{% endfor %}
        </div> {% schema %} {
    "tag": "section",
    "name": "Wirkung Olivenkraft ",
    "class": "lh_split_panel",
    "blocks": [
        {
            "name": "_Split Text",
            "type": "split-text",
            "settings": [
                {
                    "id": "text_uberschrift",
                    "type": "text",
                    "label": "\u00dcberschrift",
                    "default": "Pure Olivenkraft f\u00fcr nat\u00fcrlich gesunde Lippen"
                },
                {
                    "id": "richtext_text",
                    "type": "richtext",
                    "label": "Text",
                    "default": "<p>Lippenheld basiert auf einem der st\u00e4rksten Oliven-Antioxidantien der Welt. Die Formulierung sch\u00fctzt, regeneriert und pflegt \u2013 ganz ohne Chemie, synthetische Zus\u00e4tze oder unn\u00f6tige F\u00fcllstoffe. Pure Natur f\u00fcr gesunde Lippen.<\/p>"
                }
            ]
        },
        {
            "name": "_Split Bild",
            "type": "split-bild",
            "settings": [
                {
                    "id": "image_bild",
                    "type": "image_picker",
                    "label": "Bild"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Wirkung Olivenkraft ",
            "category": "Liquify",
            "blocks": [
                {
                    "type": "_split-text"
                },
                {
                    "type": "_split-bild"
                }
            ]
        }
    ]
} {% endschema %}