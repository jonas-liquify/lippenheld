<div li-block="Bildkachel" class="image-grid_item" {{ block.shopify_attributes }}>
                    <a href="{{ block.settings.url_link }}" class="image-grid_link"> <div class="image-grid_media">{% if block.settings.image_bild %} {{ block.settings.image_bild | image_url: width: 700 | image_tag: loading: 'lazy' }} {% else %} <img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt=""> {% endif %}</div><div class="image-grid_label">{{ block.settings.text_label }}</div> </a>
                </div> {% schema %} {
    "name": "Bildkachel",
    "settings": [
        {
            "id": "url_link",
            "type": "url",
            "label": "Link"
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_label",
            "type": "text",
            "label": "Label",
            "default": "Mein t\u00e4gliches Ritual"
        }
    ],
    "presets": [
        {
            "name": "Bildkachel",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}