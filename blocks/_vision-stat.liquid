<div class="lh_about_vision_stat" li-block="_Vision Stat" li-block:category="Stats" {{ block.shopify_attributes }}>
                    {% if block.settings.image_icon %}
{{ block.settings.image_icon | image_url: width: 1000 | image_tag: class: 'lh_about_vision_stat_icon', loading: 'lazy' }}
{% else %}
<img class="lh_about_vision_stat_icon" src="{{ 'platzhalter.svg' | asset_url }}" alt="" loading="lazy">
{% endif %}
                    <p class="lh_about_vision_stat_label">
{{ block.settings.text_label }}
</p>
                </div> {% schema %} {
    "name": "Vision Stat",
    "settings": [
        {
            "id": "image_icon",
            "type": "image_picker",
            "label": "Icon"
        },
        {
            "id": "text_label",
            "type": "text",
            "label": "Label",
            "default": "35 Jahren Erfahrung"
        }
    ],
    "presets": [
        {
            "name": "Vision Stat",
            "category": "Stats",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}