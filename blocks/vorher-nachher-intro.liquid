            "label": "Intro-Bild"
        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Testimonials"
        },
        {
            "id": "text_intro_uberschrift",
            "type": "text",
            "label": "Intro-\u00dcberschrift",
            "default": "Trusted by 100.000 Kunden"
        }
    ],
    "presets": [
        {
            "name": "Vorher Nachher Intro",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}