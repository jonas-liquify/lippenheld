<div li-block="Inhaltsstoff" class="ingredients_entry" x-data="{ i: 0 }" x-init="i = Array.prototype.indexOf.call($el.parentElement.children, $el)" {{ block.shopify_attributes }}>
                    <button type="button" class="ingredients_item" x-on:click="active = i" x-bind:class="{ 'is-active': active === i }"><span class="ingredients_item-number">
{{ block.settings.text_nummer }}
</span><span>
{{ block.settings.text_name }}
</span></button>
                    <div class="ingredients_media ingredients_pane" x-show="active === i">{% if block.settings.image_bild %}
{{ block.settings.image_bild | image_url: width: 1200 | image_tag: loading: 'lazy' }}
{% else %}
<img src="{{ 'placeholder.svg' | asset_url }}" loading="lazy" alt="">
{% endif %}</div>
                    <div class="ingredients_content ingredients_pane" x-show="active === i"><div class="ingredients_content-inner"><div class="arc-label_wrapper"><svg class="arc-label" viewbox="0 0 140 36" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false"><path id="arc-ingredients-ingredients" d="M4 32 Q70 0 136 32" fill="none" stroke="none"></path><text class="arc-label_text"><textpath href="#arc-ingredients-ingredients" startoffset="50%" text-anchor="middle" href="#arc-ingredients-ingredients">
{{ block.settings.text_subline }}
</textpath></text></svg></div><h2 class="heading-style-h2">
{{ block.settings.text_wirkstoff_titel }}
</h2><div class="text-size-regular"> {{ block.settings.richtext_wirkstoff_text }} </div><div class="button-group"><a href="{{ block.settings.url_button_link }}" class="button"> <span>{{ block.settings.text_button_text }}</span> </a></div></div></div>
                </div> {% schema %} {
    "name": "Inhaltsstoff",
    "settings": [
        {
            "id": "text_nummer",
            "type": "text",
            "label": "Nummer",
            "default": "1"
        },
        {
            "id": "text_name",
            "type": "text",
            "label": "Name",
            "default": "Hydroxytyrosol"
        },
        {
            "id": "image_bild",
            "type": "image_picker",
            "label": "Bild"
        },
        {
            "id": "text_subline",
            "type": "text",
            "label": "Subline",
            "default": "Ingredients"
        },
        {
            "id": "text_wirkstoff_titel",
            "type": "text",
            "label": "Wirkstoff-Titel",
            "default": "Hydroxytyrosol"
        },
        {
            "id": "richtext_wirkstoff_text",
            "type": "richtext",
            "label": "Wirkstoff-Text",
            "default": "<p>Hydroxytyrosol ist ein wahrer Power-Inhaltsstoff. Das nat\u00fcrliche Antioxidans hat eine Menge Vorteile f\u00fcr unsere Haut \u2013 kein Wunder, dass es in immer mehr Skincare-Produkten zu finden ist. Es sch\u00fctzt die Haut vor oxidativem Stress und sch\u00e4dlichen Umwelteinfl\u00fcssen, verlangsamt die Hautalterung und wirkt entz\u00fcndungshemmend.<\/p>"
        },
        {
            "id": "url_button_link",
            "type": "url",
            "label": "Button-Link"
        },
        {
            "id": "text_button_text",
            "type": "text",
            "label": "Button-Text",
            "default": "Mehr erfahren"
        }
    ],
    "presets": [
        {
            "name": "Inhaltsstoff",
            "blocks": []
        }
    ],
    "tag": null
} {% endschema %}